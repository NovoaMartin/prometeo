{
  "name": "red-prometeo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix web",
    "dev": "node -e \"require('fs').mkdirSync('web/dist',{recursive:true})\" && wrangler d1 migrations apply DB --local && concurrently -k -n web,api -c cyan,magenta \"npm run dev --prefix web\" \"wrangler dev --port 3001\"",
    "build": "npm run build --prefix web",
    "typecheck": "tsc -p worker && tsc -p web --noEmit",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.88",
    "ai": "^7.0.176"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "concurrently": "^9.2.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.164.0"
  }
}
