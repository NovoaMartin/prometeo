{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "red-prometeo",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Front compilado (web/dist) servido como assets; el Worker solo atiende /api/*
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "red-prometeo",
			// Reemplazar con el id que devuelve: npx wrangler d1 create red-prometeo
			"database_id": "0d795568-487b-4cdb-aedf-9362ef3baf15",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"DEEPSEEK_MODEL": "deepseek-flash"
	}
	// Secreto (no va aca): npx wrangler secret put DEEPSEEK_API_KEY
}